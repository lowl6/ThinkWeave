# ---- ThinkWeave Backend Environment Variables ----

# 数据库（默认 SQLite 零配置，切换 MySQL 只需改这一行）
# SQLite（默认，无需安装任何数据库）:
DATABASE_URL=sqlite+aiosqlite:///./thinkweave.db
# MySQL: DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/thinkweave

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI 模型 API Keys（从 AiHubMix 统一网关或各厂商直连）
AI_GATEWAY_BASE_URL=https://aihubmix.com/v1
AI_GATEWAY_API_KEY=your-api-key

# 也可以分别配置各模型厂商
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
WENXIN_API_KEY=
WENXIN_BASE_URL=
QIANWEN_API_KEY=
QIANWEN_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
FRONTEND_URL=http://localhost:5173
